{
  "lineWidth": 100,
  "indentWidth": 2,
  "useTabs": false,
  "typescript": {
    "quoteStyle": "preferSingle",
    "jsx.quoteStyle": "preferDouble",
    "semiColons": "prefer",
    "trailingCommas": "onlyMultiLine",
    "quoteProps": "asNeeded",
    "useBraces": "always",
    "singleBodyPosition": "nextLine"
  },
  "json": {},
  "excludes": [
    ".claude/**",
    "pnpm-lock.yaml"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.96.1.wasm",
    "https://plugins.dprint.dev/json-0.25.2.wasm"
  ]
}
